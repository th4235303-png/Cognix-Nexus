PORT=8003
COGNIX_CORS_ORIGINS=http://localhost:3002,http://localhost:3000

# Telegram Bot & Topic Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ENABLED=false

# QStash request signature verification (worker only)
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_CALLBACK_URL=https://cognix-core-worker-runtime.onrender.com/qstash/process

# Production secrets are supplied through the hosting provider secret manager.
# DATABASE_URL=

# Storage roles:
# Cloudinary = research images/covers/thumbnails (<10 MB).
# Supabase Storage = small PDFs, notes, summaries (<=50 MB).
# Backblaze B2 = large PDFs, EPUBs, research papers (>50 MB).
# Google Drive = export packages and backups.
COGNIX_BOOK_STORAGE_PROVIDER=tiered
COGNIX_B2_LARGE_FILE_THRESHOLD_BYTES=52428800
COGNIX_MAX_BOOK_UPLOAD_BYTES=209715200
COGNIX_MEDIA_STORAGE_PROVIDER=cloudinary
# Cloudinary backend-only credentials.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_RESOURCE_TYPE=raw
CLOUDINARY_DELIVERY_TYPE=authenticated

# Legacy B2/R2 compatibility (not used by the production primary path).
# COGNIX_B2_ENDPOINT=https://s3.<region>.backblazeb2.com
# COGNIX_B2_BUCKET=
# COGNIX_B2_KEY_ID=
# COGNIX_B2_APPLICATION_KEY=
COGNIX_B2_REGION=eu-central-003

# Backend-only Supabase Storage credentials.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
COGNIX_SUPABASE_STORAGE_BUCKET=cognix-artifacts

# Legacy optional Cloudflare R2 compatibility.
# COGNIX_R2_ENDPOINT=
# COGNIX_R2_BUCKET=
# COGNIX_R2_ACCESS_KEY_ID=
# COGNIX_R2_SECRET_ACCESS_KEY=
COGNIX_R2_REGION=auto

# Google Drive
COGNIX_DRIVE_PROVIDER=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Monitoring
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Authentication
COGNIX_AUTH_REQUIRED=false
# COGNIX_JWT_JWKS_URL=
# COGNIX_JWT_ISSUER=
# COGNIX_JWT_AUDIENCE=

# Provider credentials (server-side only). Endpoints and model IDs are in code.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# HUGGINGFACE_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# GROQ_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# VOYAGE_API_KEY=

# Processing mode
COGNIX_PROCESSING_PROVIDER=mock

# Embeddings use the database's fixed vector(1536) schema. A dimension change
# requires a database migration and re-embedding; do not set it in Render.

# Worker
COGNIX_WORKER_POLL_SECONDS=2

# Release-gate operator inputs (never commit real values)
# COGNIX_E2E_BASE_URL=
# COGNIX_E2E_API_URL=
# COGNIX_E2E_EMAIL=
# COGNIX_E2E_PASSWORD=


# === Added by audit (missing from .env.example) ===

# AXIOM
AXIOM_DATASET=
AXIOM_INGEST_URL=https://example.com
AXIOM_TOKEN=your_token_here

# CLOUDFLARE
CLOUDFLARE_ACCOUNT_ID=your_id_here
CLOUDFLARE_API_TOKEN=your_token_here

# CLOUDINARY
CLOUDINARY_API_KEY=your_key_here
CLOUDINARY_API_SECRET=your_secret_here
CLOUDINARY_CLOUD_NAME=

# COGNIX
COGNIX_B2_APPLICATION_KEY=your_key_here
COGNIX_B2_BUCKET=
COGNIX_B2_ENDPOINT=
COGNIX_B2_KEY_ID=your_key_here
COGNIX_JWT_AUDIENCE=
COGNIX_JWT_ISSUER=
COGNIX_JWT_JWKS_URL=https://example.com
COGNIX_JWT_SECRET=your_secret_here

# COHERE
COHERE_API_KEY=your_key_here

# DATABASE
DATABASE_URL=postgresql://user:password@host:5432/dbname

# GOOGLE
GOOGLE_CLIENT_ID=your_id_here
GOOGLE_CLIENT_SECRET=your_secret_here
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_id_here
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=your_key_here
GOOGLE_OAUTH_STATE_SECRET=your_secret_here
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=your_token_here

# GROQ
GROQ_API_KEY=your_key_here

# HUGGINGFACE
HUGGINGFACE_API_KEY=your_key_here

# MISTRAL
MISTRAL_API_KEY=your_key_here

# OPENROUTER
OPENROUTER_API_KEY=your_key_here

# QDRANT
QDRANT_API_KEY=your_key_here
QDRANT_CLUSTER_ENDPOINT=
QDRANT_COLLECTION_NAME=

# QSTASH
QSTASH_CURRENT_SIGNING_KEY=your_key_here
QSTASH_NEXT_SIGNING_KEY=your_key_here
QSTASH_TOKEN=your_token_here
QSTASH_URL=https://example.com

# SENTRY
SENTRY_DSN=

# SUPABASE
SUPABASE_SERVICE_ROLE_KEY=your_key_here
SUPABASE_URL=https://your-project.supabase.co

# UMAMI
UMAMI_WEBSITE_ID=your_id_here

# UPSTASH
UPSTASH_REDIS_REST_TOKEN=your_token_here
UPSTASH_REDIS_REST_URL=https://example.com

# VOYAGE
VOYAGE_API_KEY=your_key_here

# --- Additional Configuration ---
COGNIX_DEV_MODE=true
COGNIX_ENV=development
COGNIX_LOG_LEVEL=INFO
COGNIX_REQUIRE_DATABASE=false
DEBUG=false
GEMINI_API_KEY=
REDIS_URL=
