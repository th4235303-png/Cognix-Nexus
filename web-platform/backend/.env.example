# Comma-separated browser origins allowed to call the API.
# Keep this limited to known application origins in production.
COGNIX_CORS_ORIGINS=http://localhost:3000

# Production-only secrets are supplied through the hosting provider secret manager.
# DATABASE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# SENTRY_DSN=
# COGNIX_BOOK_STORAGE_PROVIDER=local
# COGNIX_MEDIA_STORAGE_PROVIDER=local
# COGNIX_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# COGNIX_R2_BUCKET=cognix-core
# COGNIX_R2_ACCESS_KEY_ID=
# COGNIX_R2_SECRET_ACCESS_KEY=
# COGNIX_R2_REGION=auto
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Authentication
COGNIX_AUTH_REQUIRED=false
# COGNIX_JWT_SECRET=
# COGNIX_JWT_JWKS_URL=
# COGNIX_JWT_ISSUER=
# COGNIX_JWT_AUDIENCE=

# Processing
COGNIX_PROCESSING_PROVIDER=mock
# COGNIX_AI_BASE_URL=
# COGNIX_AI_API_KEY=
# COGNIX_AI_MODEL=
# COGNIX_LLM_FALLBACK_URLS=https://fallback-1.example/v1/chat/completions,https://fallback-2.example/v1/chat/completions
# COGNIX_LLM_TIMEOUT_SECONDS=90

# Google Drive
COGNIX_DRIVE_PROVIDER=mock
# GOOGLE_REFRESH_TOKEN=

# Brain Vault document storage / semantic retrieval
# Use a persistent Render disk path or an object-storage adapter in production.
# COGNIX_BOOK_STORAGE_DIR=/var/lib/cognix/books
# COGNIX_EMBEDDING_API_URL=
# COGNIX_EMBEDDING_API_KEY=
# COGNIX_EMBEDDING_MODEL=
COGNIX_EMBEDDING_DIMENSION=1536

# Worker reliability
# COGNIX_WORKER_ID=worker-01
COGNIX_WORKER_POLL_SECONDS=2
