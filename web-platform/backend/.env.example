# Comma-separated browser origins allowed to call the API.
COGNIX_CORS_ORIGINS=http://localhost:3000

# Production secrets are supplied through the hosting provider secret manager.
# DATABASE_URL=

# Storage roles:
# Cloudinary = research images/covers/thumbnails (<10 MB).
# Supabase Storage = small PDFs, notes, summaries (<=50 MB).
# Backblaze B2 = large PDFs, EPUBs, research papers (>50 MB).
# Google Drive = export packages and backups.
COGNIX_BOOK_STORAGE_PROVIDER=tiered
COGNIX_B2_LARGE_FILE_THRESHOLD_BYTES=52428800
COGNIX_MAX_BOOK_UPLOAD_BYTES=209715200
COGNIX_MEDIA_STORAGE_PROVIDER=cloudinary
# Cloudinary backend-only credentials.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_RESOURCE_TYPE=raw
CLOUDINARY_DELIVERY_TYPE=authenticated

# Legacy B2/R2 compatibility (not used by the production primary path).
# COGNIX_B2_ENDPOINT=https://s3.<region>.backblazeb2.com
# COGNIX_B2_BUCKET=
# COGNIX_B2_KEY_ID=
# COGNIX_B2_APPLICATION_KEY=
COGNIX_B2_REGION=eu-central-003

# Backend-only Supabase Storage credentials.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
COGNIX_SUPABASE_STORAGE_BUCKET=cognix-artifacts

# Legacy optional Cloudflare R2 compatibility.
# COGNIX_R2_ENDPOINT=
# COGNIX_R2_BUCKET=
# COGNIX_R2_ACCESS_KEY_ID=
# COGNIX_R2_SECRET_ACCESS_KEY=
COGNIX_R2_REGION=auto

# Google Drive
COGNIX_DRIVE_PROVIDER=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Monitoring
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Authentication
COGNIX_AUTH_REQUIRED=false
# COGNIX_JWT_JWKS_URL=
# COGNIX_JWT_ISSUER=
# COGNIX_JWT_AUDIENCE=

# Multi-provider AI credentials (backend-only; do not commit real values)
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# HUGGINGFACE_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# GROQ_API_KEY=
# VOYAGE_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Optional integer weights, e.g. openrouter=2,gemini=1,groq=1
# COGNIX_LLM_PROVIDER_WEIGHTS=
# COGNIX_EMBEDDING_PROVIDER_WEIGHTS=

# Processing / AI
COGNIX_PROCESSING_PROVIDER=mock
# COGNIX_AI_BASE_URL=
# COGNIX_AI_API_KEY=
# COGNIX_AI_MODEL=
# COGNIX_LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# COGNIX_LLM_API_KEY=
COGNIX_LLM_MODEL=openai/gpt-chat-latest
# COGNIX_LLM_FALLBACK_URLS=
# COGNIX_LLM_TIMEOUT_SECONDS=90

# Embeddings
# COGNIX_EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
# COGNIX_EMBEDDING_API_KEY=
# COGNIX_EMBEDDING_MODEL=
COGNIX_EMBEDDING_DIMENSION=1536

# Worker
COGNIX_WORKER_POLL_SECONDS=2

# Release-gate operator inputs (never commit real values)
# COGNIX_E2E_BASE_URL=
# COGNIX_E2E_API_URL=
# COGNIX_E2E_EMAIL=
# COGNIX_E2E_PASSWORD=
