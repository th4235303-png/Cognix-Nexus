# Comma-separated browser origins allowed to call the API.
COGNIX_CORS_ORIGINS=http://localhost:3000

# Production secrets are supplied through the hosting provider secret manager.
# DATABASE_URL=

# Storage roles:
# B2 = original books/media; Supabase Storage = app artifacts; Google Drive = exports/backups.
COGNIX_BOOK_STORAGE_PROVIDER=b2
COGNIX_MEDIA_STORAGE_PROVIDER=b2
# COGNIX_B2_ENDPOINT=https://s3.<region>.backblazeb2.com
# COGNIX_B2_BUCKET=
# COGNIX_B2_KEY_ID=
# COGNIX_B2_APPLICATION_KEY=
COGNIX_B2_REGION=us-east-005

# Backend-only Supabase Storage credentials.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
COGNIX_SUPABASE_STORAGE_BUCKET=cognix-artifacts

# Legacy optional Cloudflare R2 compatibility.
# COGNIX_R2_ENDPOINT=
# COGNIX_R2_BUCKET=
# COGNIX_R2_ACCESS_KEY_ID=
# COGNIX_R2_SECRET_ACCESS_KEY=
COGNIX_R2_REGION=auto

# Google Drive
COGNIX_DRIVE_PROVIDER=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Monitoring
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Authentication
COGNIX_AUTH_REQUIRED=false
# COGNIX_JWT_JWKS_URL=
# COGNIX_JWT_ISSUER=
# COGNIX_JWT_AUDIENCE=

# Processing / AI
COGNIX_PROCESSING_PROVIDER=mock
# COGNIX_AI_BASE_URL=
# COGNIX_AI_API_KEY=
# COGNIX_AI_MODEL=
# COGNIX_LLM_FALLBACK_URLS=
# COGNIX_LLM_TIMEOUT_SECONDS=90

# Embeddings
# COGNIX_EMBEDDING_API_URL=
# COGNIX_EMBEDDING_API_KEY=
# COGNIX_EMBEDDING_MODEL=
COGNIX_EMBEDDING_DIMENSION=1536

# Worker
COGNIX_WORKER_POLL_SECONDS=2
