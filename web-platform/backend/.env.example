# Comma-separated browser origins allowed to call the API.
# Keep this limited to known application origins in production.
COGNIX_CORS_ORIGINS=http://localhost:3000

# Production-only secrets are supplied through the hosting provider secret manager.
# DATABASE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# SENTRY_DSN=

# Authentication
COGNIX_AUTH_REQUIRED=false
# COGNIX_JWT_SECRET=
# COGNIX_JWT_JWKS_URL=
# COGNIX_JWT_ISSUER=
# COGNIX_JWT_AUDIENCE=

# Processing
COGNIX_PROCESSING_PROVIDER=mock
# COGNIX_AI_BASE_URL=
# COGNIX_AI_API_KEY=
# COGNIX_AI_MODEL=

# Google Drive
COGNIX_DRIVE_PROVIDER=mock
# GOOGLE_REFRESH_TOKEN=
