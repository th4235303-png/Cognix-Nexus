# Frontend
NEXT_PUBLIC_COGNIX_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend
COGNIX_CORS_ORIGINS=http://localhost:3000
# DATABASE_URL=

# Authentication
# Keep these server-side only. Enable auth only after a trusted JWT issuer is configured.
COGNIX_AUTH_REQUIRED=false
# COGNIX_JWT_SECRET=
# COGNIX_JWT_ISSUER=
# COGNIX_JWT_AUDIENCE=

# Research processing (server-side)
COGNIX_PROCESSING_PROVIDER=mock

# Provider credentials only; endpoints and model IDs are configured in code.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# HUGGINGFACE_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# GROQ_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# VOYAGE_API_KEY=
# COGNIX_MAX_DOCUMENT_BYTES=2097152

# Google Drive provider
COGNIX_DRIVE_PROVIDER=mock
# GOOGLE_REFRESH_TOKEN=

# Google Drive / OAuth (server-side only)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Sentry (server-side unless the SDK requires a public DSN)
# SENTRY_DSN=
