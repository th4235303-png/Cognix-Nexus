# ==============================================================================
# COGNIX-NEXUS: PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Target Deployment: Render (API & Worker), Expo (Mobile)
# Architecture: 100% Standalone Decoupled Second Brain & Learning System
# Format: [Platform / Component Target] [Variable Name]=
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER — BACKEND API (Core Web Service)
# ------------------------------------------------------------------------------
# Render — Backend API	COGNIX_ENV
COGNIX_ENV=production

# Render — Backend API	DEBUG
DEBUG=false

# Render — Backend API	PORT
PORT=8003

# Render — Backend API	HOST
HOST=0.0.0.0

# Render — Backend API	FRONTEND_BASE_URL
FRONTEND_BASE_URL=https://cognix-nexus-frontend.onrender.com

# Render — Backend API	COGNIX_CORS_ORIGINS
COGNIX_CORS_ORIGINS=https://cognix-nexus-frontend.onrender.com

# Render — Backend API	CORS_EXTRA_ORIGINS
CORS_EXTRA_ORIGINS=

# Render — Backend API	COGNIX_ALLOWED_HOSTS
COGNIX_ALLOWED_HOSTS=cognix-core-ypak.onrender.com,localhost,127.0.0.1

# Render — Backend API	COGNIX_RATE_LIMIT_PER_MINUTE
COGNIX_RATE_LIMIT_PER_MINUTE=120

# Render — Backend API	COGNIX_RATE_LIMIT_MAX_IDENTITIES
COGNIX_RATE_LIMIT_MAX_IDENTITIES=10000

# Render — Backend API	COGNIX_REQUIRE_DATABASE
COGNIX_REQUIRE_DATABASE=true

# Render — Backend API	DATABASE_URL (PostgreSQL pooled connection string)
DATABASE_URL=

# Render — Backend API	COGNIX_DB_POOL_MIN
COGNIX_DB_POOL_MIN=2

# Render — Backend API	COGNIX_DB_POOL_MAX
COGNIX_DB_POOL_MAX=20

# Render — Backend API	COGNIX_AUTH_REQUIRED
COGNIX_AUTH_REQUIRED=true

# Render — Backend API	COGNIX_JWT_JWKS_URL
COGNIX_JWT_JWKS_URL=https://jarfusheiqkfcbeljvhj.supabase.co/auth/v1/.well-known/jwks.json

# Render — Backend API	COGNIX_JWT_ISSUER
COGNIX_JWT_ISSUER=https://jarfusheiqkfcbeljvhj.supabase.co/auth/v1

# Render — Backend API	COGNIX_JWT_AUDIENCE
COGNIX_JWT_AUDIENCE=authenticated

# Render — Backend API	COGNIX_JWT_SECRET
COGNIX_JWT_SECRET=

# Render — Backend API	SENTRY_DSN
SENTRY_DSN=

# Render — Backend API	SENTRY_ENVIRONMENT
SENTRY_ENVIRONMENT=production

# Render — Backend API	SENTRY_TRACES_SAMPLE_RATE
SENTRY_TRACES_SAMPLE_RATE=0.2

# ------------------------------------------------------------------------------
# 2. RENDER — MULTI-STORAGE MATRIX (Cloudinary, Backblaze B2, Supabase)
# ------------------------------------------------------------------------------
# Render — Storage	COGNIX_BOOK_STORAGE_PROVIDER (tiered, b2, cloudinary, supabase, local)
COGNIX_BOOK_STORAGE_PROVIDER=tiered

# Render — Storage	COGNIX_MEDIA_STORAGE_PROVIDER
COGNIX_MEDIA_STORAGE_PROVIDER=cloudinary

# Render — Storage	COGNIX_B2_LARGE_FILE_THRESHOLD_BYTES
COGNIX_B2_LARGE_FILE_THRESHOLD_BYTES=52428800

# Render — Storage	COGNIX_MAX_BOOK_UPLOAD_BYTES
COGNIX_MAX_BOOK_UPLOAD_BYTES=209715200

# Render — Storage	CLOUDINARY_CLOUD_NAME
CLOUDINARY_CLOUD_NAME=

# Render — Storage	CLOUDINARY_API_KEY
CLOUDINARY_API_KEY=

# Render — Storage	CLOUDINARY_API_SECRET
CLOUDINARY_API_SECRET=

# Render — Storage	CLOUDINARY_RESOURCE_TYPE
CLOUDINARY_RESOURCE_TYPE=raw

# Render — Storage	CLOUDINARY_DELIVERY_TYPE
CLOUDINARY_DELIVERY_TYPE=authenticated

# Render — Storage	CLOUDINARY_MAX_RAW_BYTES
CLOUDINARY_MAX_RAW_BYTES=10485760

# Render — Storage	SUPABASE_URL
SUPABASE_URL=https://jarfusheiqkfcbeljvhj.supabase.co

# Render — Storage	SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Render — Storage	COGNIX_SUPABASE_STORAGE_BUCKET
COGNIX_SUPABASE_STORAGE_BUCKET=cognix-artifacts

# Render — Storage	COGNIX_B2_ENDPOINT
COGNIX_B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Render — Storage	COGNIX_B2_BUCKET
COGNIX_B2_BUCKET=cognix-knowledge-vault

# Render — Storage	COGNIX_B2_KEY_ID
COGNIX_B2_KEY_ID=

# Render — Storage	COGNIX_B2_APPLICATION_KEY
COGNIX_B2_APPLICATION_KEY=

# Render — Storage	COGNIX_B2_REGION
COGNIX_B2_REGION=us-west-004

# ------------------------------------------------------------------------------
# 3. RENDER — MULTI-PROVIDER AI FAILOVER ENGINE (Research & Learning Science)
# ------------------------------------------------------------------------------
# Render — AI Providers	COGNIX_PROCESSING_PROVIDER
COGNIX_PROCESSING_PROVIDER=ai

# Render — AI Providers	OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Render — AI Providers	OPENROUTER_BASE_URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Render — AI Providers	OPENROUTER_MODELS
OPENROUTER_MODELS=google/gemma-4-31b-it:free,cohere/north-mini-code:free,meta-llama/llama-3.3-70b-instruct:free

# Render — AI Providers	GEMINI_API_KEY
GEMINI_API_KEY=

# Render — AI Providers	GEMINI_BASE_URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Render — AI Providers	GEMINI_MODEL
gemini-2.5-flash

# Render — AI Providers	GROQ_API_KEY
GROQ_API_KEY=

# Render — AI Providers	GROQ_BASE_URL
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Render — AI Providers	GROQ_MODEL
GROQ_MODEL=llama-3.3-70b-versatile

# Render — AI Providers	MISTRAL_API_KEY
MISTRAL_API_KEY=

# Render — AI Providers	MISTRAL_BASE_URL
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Render — AI Providers	MISTRAL_MODEL
MISTRAL_MODEL=mistral-small-latest

# Render — AI Providers	COHERE_API_KEY
COHERE_API_KEY=

# Render — AI Providers	COHERE_BASE_URL
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1

# Render — AI Providers	COHERE_MODEL
COHERE_MODEL=command-r-08-2024

# Render — AI Providers	NVIDIA_API_KEY
NVIDIA_API_KEY=

# Render — AI Providers	NVIDIA_MODEL
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Render — AI Providers	HUGGINGFACE_API_KEY
