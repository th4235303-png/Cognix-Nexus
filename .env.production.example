# ==============================================================================
# COGNIX-NEXUS: PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Current Render/Supabase production contract. Secret values intentionally blank.
# ==============================================================================

# --- RUNTIME & SERVER ---
COGNIX_ENV=production
DEBUG=false
COGNIX_DEV_MODE=false
COGNIX_LOG_LEVEL=INFO
PORT=8003
HOST=0.0.0.0
COGNIX_WORKER_POLL_SECONDS=2
COGNIX_WORKER_ID=cognix-prod-worker-1

# --- CORS & NETWORK HARDENING ---
COGNIX_CORS_ORIGINS=https://cognix-nexus-frontend.onrender.com
COGNIX_ALLOWED_HOSTS=cognix-core-ypak.onrender.com,cognix-nexus-frontend.onrender.com
COGNIX_RATE_LIMIT_PER_MINUTE=120
COGNIX_RATE_LIMIT_MAX_IDENTITIES=10000

# --- DATABASE & CONNECTION POOLING ---
COGNIX_REQUIRE_DATABASE=true
DATABASE_URL=
COGNIX_DB_POOL_MIN=2
COGNIX_DB_POOL_MAX=20

# --- AUTHENTICATION & JWT ---
COGNIX_AUTH_REQUIRED=true
COGNIX_JWT_JWKS_URL=https://jarfusheiqkfcbeljvhj.supabase.co/auth/v1/.well-known/jwks.json
COGNIX_JWT_ISSUER=https://jarfusheiqkfcbeljvhj.supabase.co/auth/v1
COGNIX_JWT_AUDIENCE=authenticated
COGNIX_JWT_SECRET=

# --- TIERED HYBRID STORAGE ---
COGNIX_BOOK_STORAGE_PROVIDER=tiered
COGNIX_MEDIA_STORAGE_PROVIDER=cloudinary
COGNIX_B2_LARGE_FILE_THRESHOLD_BYTES=52428800
COGNIX_MAX_BOOK_UPLOAD_BYTES=209715200

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RESOURCE_TYPE=raw
CLOUDINARY_DELIVERY_TYPE=authenticated
CLOUDINARY_MAX_RAW_BYTES=10485760

# Supabase Storage
SUPABASE_URL=https://jarfusheiqkfcbeljvhj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
COGNIX_SUPABASE_STORAGE_BUCKET=cognix-artifacts

# Backblaze B2 — endpoint/bucket are intentionally blank until the live values are confirmed
COGNIX_B2_ENDPOINT=
COGNIX_B2_BUCKET=
COGNIX_B2_KEY_ID=
COGNIX_B2_APPLICATION_KEY=
COGNIX_B2_REGION=eu-central-003

# Google Drive
COGNIX_DRIVE_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cognix-core-ypak.onrender.com/integrations/google-drive/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# OCR
COGNIX_OCR_TESSERACT_CONFIG=--psm 3

# --- MULTI-PROVIDER AI ---
COGNIX_PROCESSING_PROVIDER=ai
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=
HUGGINGFACE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- FRONTEND (public values only) ---
NEXT_PUBLIC_COGNIX_API_URL=https://cognix-core-ypak.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://jarfusheiqkfcbeljvhj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put server secrets in NEXT_PUBLIC_* variables.
