CLOUDFLARE_API_TOKEN=

# Render — AI Providers	CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 4. RENDER — QDRANT VECTOR SECOND BRAIN (Semantic Note & Concept Index)
# ------------------------------------------------------------------------------
# Render — Qdrant	QDRANT_API_KEY
QDRANT_API_KEY=

# Render — Qdrant	QDRANT_CLUSTER_ENDPOINT
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io

# Render — Qdrant	QDRANT_COLLECTION_NAME
QDRANT_COLLECTION_NAME=cognix_knowledge_vault

# ------------------------------------------------------------------------------
# 5. RENDER — UPSTASH QSTASH & REDIS (Spaced Repetition & Ingestion Jobs)
# ------------------------------------------------------------------------------
# Render — Upstash QStash	QSTASH_URL
QSTASH_URL=https://qstash-us-east-1.upstash.io

# Render — Upstash QStash	QSTASH_REGION
QSTASH_REGION=US_EAST_1

# Render — Upstash QStash	QSTASH_TOKEN
QSTASH_TOKEN=

# Render — Upstash QStash	QSTASH_CURRENT_SIGNING_KEY
QSTASH_CURRENT_SIGNING_KEY=

# Render — Upstash QStash	QSTASH_NEXT_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=

# Render — Upstash Redis	REDIS_URL
REDIS_URL=

# Render — Upstash Redis	UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_URL=

# Render — Upstash Redis	UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 6. RENDER — OBSERVABILITY, LOGS & ANALYTICS (Axiom, Sentry, Umami)
# ------------------------------------------------------------------------------
# Render — Observability	AXIOM_TOKEN
AXIOM_TOKEN=

# Render — Observability	AXIOM_DATASET
AXIOM_DATASET=cognix-nexus-production

# Render — Observability	UMAMI_WEBSITE_ID
UMAMI_WEBSITE_ID=

# Render — Observability	UMAMI_HOST_URL
UMAMI_HOST_URL=https://cloud.umami.is

# ------------------------------------------------------------------------------
# 7. RENDER — GOOGLE DRIVE OAUTH (Book Backup & Two-Way Sync)
# ------------------------------------------------------------------------------
# Render — Google Drive	GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Render — Google Drive	GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=

