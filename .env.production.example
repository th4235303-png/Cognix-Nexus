# ==============================================================================
# COGNIX-NEXUS: PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# (Non-Docker Native / Systemd / PM2 Deployment)
#
# Instructions:
# 1. Copy this file to .env (or web-platform/backend/.env and web-platform/frontend/.env.local)
# 2. Populate all empty values with real production secrets.
# 3. Restrict permissions (chmod 600 .env).
# ==============================================================================

# --- RUNTIME & SERVER ---
COGNIX_ENV=production
DEBUG=false
COGNIX_LOG_LEVEL=INFO
PORT=8001
HOST=127.0.0.1
COGNIX_WORKER_POLL_SECONDS=2
COGNIX_WORKER_ID=cognix-prod-worker-1

# --- CORS & NETWORK HARDENING ---
# Strict comma-separated list of origins (NO wildcards '*')
COGNIX_CORS_ORIGINS=https://cognix.yourdomain.com
COGNIX_ALLOWED_HOSTS=cognix.yourdomain.com,api.cognix.yourdomain.com,127.0.0.1
COGNIX_RATE_LIMIT_PER_MINUTE=120
COGNIX_RATE_LIMIT_MAX_IDENTITIES=10000

# --- DATABASE & CONNECTION POOLING (PostgreSQL / Supabase) ---
COGNIX_REQUIRE_DATABASE=true
# Example: postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/cognix_production?sslmode=require
COGNIX_DB_POOL_MIN=2
COGNIX_DB_POOL_MAX=20

# --- AUTHENTICATION & JWT (Supabase / Auth0) ---
COGNIX_AUTH_REQUIRED=true
COGNIX_JWT_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
COGNIX_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
COGNIX_JWT_AUDIENCE=authenticated
COGNIX_JWT_SECRET=replace-with-jwt-secret-if-symmetric

# --- TIERED HYBRID STORAGE ARCHITECTURE ---
# Tier 1 (Media/Images <10MB): Cloudinary
# Tier 2 (PDFs/Notes <=50MB): Supabase Storage
# Tier 3 (Large Files >50MB): Backblaze B2
# Tier 4 (Exports/Backups): Google Drive
COGNIX_BOOK_STORAGE_PROVIDER=tiered
COGNIX_MEDIA_STORAGE_PROVIDER=cloudinary
COGNIX_B2_LARGE_FILE_THRESHOLD_BYTES=52428800
COGNIX_MAX_BOOK_UPLOAD_BYTES=209715200

# Cloudinary (Media assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RESOURCE_TYPE=raw
CLOUDINARY_DELIVERY_TYPE=authenticated

# Supabase Storage (Research documents)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
COGNIX_SUPABASE_STORAGE_BUCKET=cognix-artifacts

# Backblaze B2 (High-volume cold storage)
COGNIX_B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
COGNIX_B2_BUCKET=cognix-prod-vault
COGNIX_B2_KEY_ID=
COGNIX_B2_APPLICATION_KEY=
COGNIX_B2_REGION=us-west-004

# Google Drive (Export packages & backups)
COGNIX_DRIVE_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cognix.yourdomain.com/api/integrations/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- TELEGRAM BOT ALERTS & INCIDENT REPORTING ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# --- SENTRY OBSERVABILITY ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# --- MULTI-PROVIDER AI & VECTOR SEARCH ENGINE ---
COGNIX_PROCESSING_PROVIDER=ai
AI_PROVIDER_ORDER=gemini,groq,openrouter,mistral,cohere,voyage
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_COOLDOWN_SECONDS=30

GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=
HUGGINGFACE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- FRONTEND (Next.js) ---
NEXT_PUBLIC_COGNIX_API_URL=https://cognix.yourdomain.com/v1
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key
